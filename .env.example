# CDEXIO dashboard — copy to .env.local and fill in. Never commit the real file.

# --- Google OAuth ---------------------------------------------------------
# Authorised redirect URI in Google Cloud Console:
#   https://<your-host>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Access control -------------------------------------------------------
# Comma-separated addresses. Anyone with a Google account can attempt the
# sign-in, so without this list "sign in with Google" means "sign in".
# AN EMPTY VALUE REFUSES EVERYONE — a missing variable must not publish the
# account, so the failure is closed rather than open.
ALLOWED_EMAILS=

# --- Second factor --------------------------------------------------------
# SHA-256 of the PIN, not the PIN. Generate with:
#   printf '123456' | sha256sum
# Replaced by a passkey once the agent is settled; only src/app/api/pin
# changes when that happens.
DASHBOARD_PIN_SHA256=

# --- Device lock ----------------------------------------------------------
# SHA-256 fingerprint of the owner's browser, 64 hex characters. Shown on the
# /device page the first time the owner signs in on their own phone. This
# device cannot be removed from the dashboard; other devices are approved and
# removed from it under Settings → Devices.
# EMPTY REFUSES EVERY DEVICE except ones already approved in DEVICES_FILE.
OWNER_DEVICE_HASH=
# Where approved and pending devices are kept. Default: ./data/devices.json
# DEVICES_FILE=/opt/cdexio-dashboard/data/devices.json

# --- Session --------------------------------------------------------------
# Google sign-in lasts 7 days from sign-in. The PIN is asked again after 1
# hour idle or 15 minutes closed — see src/lib/access.ts.
# openssl rand -base64 32
AUTH_SECRET=
# The public origin, used to build OAuth callbacks.
AUTH_URL=https://your-host

# --- Bot API --------------------------------------------------------------
# The read-only service on the trading machine. Bound to localhost there, so
# this dashboard must run on the same host or reach it over a private link.
# It has NO authentication of its own — this app is its access control.
BOT_API_URL=http://127.0.0.1:8790
